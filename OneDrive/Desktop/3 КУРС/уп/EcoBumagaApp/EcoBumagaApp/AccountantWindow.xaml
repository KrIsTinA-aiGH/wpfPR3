<Window x:Class="EcoBumagaApp.AccountantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Бухгалтерия"
        Height="800"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA">
    <Window.Resources>
        <Style x:Key="DataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1F2A38"/>
            <Setter Property="Foreground" Value="#F7FAFC"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FinancialCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Direction="320" ShadowDepth="1" BlurRadius="4" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#1F2A38">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Логотип и название -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                    <TextBlock Text="💰" FontSize="28" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="БУХГАЛТЕРИЯ"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="Финансы и учёт"
                                   FontSize="11"
                                   Foreground="#CBD5E0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Информация о бухгалтере -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock x:Name="txtAccountantName" Text=""
                               Foreground="White"
                               FontSize="16"
                               HorizontalAlignment="Right"/>
                    <TextBlock Text="Финансовый учёт и отчётность"
                               Foreground="#CBD5E0"
                               FontSize="11"
                               HorizontalAlignment="Right"/>
                </StackPanel>

                <!-- Кнопки управления -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Content="📊 Отчёт" Width="100" Height="35" Margin="5"
                            Background="#2F855A" Foreground="White"/>
                    <Button Content="📤 Экспорт" Width="100" Height="35" Margin="5"
                            Background="#2B6CB0" Foreground="White"/>
                    <Button x:Name="btnLogout" Content="Выйти" Width="80" Height="35" Margin="5"
                            Background="#2D3748" Foreground="White" Click="BtnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основной контент с вкладками -->
        <TabControl Grid.Row="1" Margin="15" Background="White" BorderBrush="#CBD5E0" BorderThickness="1">
            <!-- Вкладка 1: Счета и платежи -->
            <TabItem Header="📄 Счета и платежи">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Панель управления -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="➕ Новый счёт" Width="120" Height="35" Margin="5"
                                Background="#2F855A" Foreground="White"/>
                        <Button Content="✅ Провести платёж" Width="140" Height="35" Margin="5"
                                Background="#2B6CB0" Foreground="White"/>
                        <Button Content="🔄 Обновить" Width="100" Height="35" Margin="5"
                                Background="#2B6CB0" Foreground="White"/>
                        <Separator Width="20" Visibility="Hidden"/>
                        <ComboBox Width="150" Height="35" Margin="5" SelectedIndex="0">
                            <ComboBoxItem Content="Все статусы"/>
                            <ComboBoxItem Content="Ожидает оплаты"/>
                            <ComboBoxItem Content="Оплачен"/>
                            <ComboBoxItem Content="Просрочен"/>
                        </ComboBox>
                        <DatePicker Width="150" Height="35" Margin="5" SelectedDateFormat="Short"/>
                        <DatePicker Width="150" Height="35" Margin="5" SelectedDateFormat="Short"/>
                        <Button Content="🔍 Поиск" Width="100" Height="35" Margin="5"
                                Background="#4A5568" Foreground="White"/>
                    </StackPanel>

                    <!-- Список счетов -->
                    <DataGrid Grid.Row="1"
                              x:Name="dgInvoices"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              RowHeight="40"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№ счета" Width="90" Binding="{Binding InvoiceId}" HeaderStyle="{StaticResource DataGridHeaderStyle}"/>
                            <DataGridTextColumn Header="Клиент" Width="180" Binding="{Binding ClientName}"/>
                            <DataGridTextColumn Header="Дата создания" Width="110" Binding="{Binding CreatedDate, StringFormat=dd.MM.yyyy}"/>
                            <DataGridTextColumn Header="Сумма" Width="100" Binding="{Binding TotalAmount, StringFormat={}{0:N2} руб.}"/>
                            <DataGridTextColumn Header="Статус" Width="120">
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                                <DataGridTextColumn.Binding>
                                    <Binding Path="Status.StatusName"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Дата оплаты" Width="110" Binding="{Binding PaymentDate, StringFormat=dd.MM.yyyy}"/>
                            <DataGridTemplateColumn Header="Действия" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="📄" Width="30" Height="30" Margin="2" ToolTip="Печать счёта"/>
                                            <Button Content="💳" Width="30" Height="30" Margin="2" ToolTip="Провести платёж"/>
                                            <Button Content="📧" Width="30" Height="30" Margin="2" ToolTip="Отправить по email"/>
                                            <Button Content="👁️" Width="30" Height="30" Margin="2" ToolTip="Просмотр деталей" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Вкладка 2: Касса и банк -->
            <TabItem Header="💰 Касса и банк">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Левая часть - приход/расход -->
                    <Grid Grid.Column="0" Margin="0,0,5,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Быстрые операции -->
                        <Border Grid.Row="0" Style="{StaticResource FinancialCardStyle}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Быстрые операции" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                        <Button Content="💵 Внесение наличных" Height="35" Margin="0,0,0,5"
                                                Background="#2F855A" Foreground="White"/>
                                        <Button Content="🏦 Банковский перевод" Height="35" Margin="0,0,0,5"
                                                Background="#2B6CB0" Foreground="White"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                        <Button Content="💸 Выдача наличных" Height="35" Margin="0,0,0,5"
                                                Background="#9B2C2C" Foreground="White"/>
                                        <Button Content="🧾 Расходный ордер" Height="35"
                                                Background="#9B2C2C" Foreground="White"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Последние операции -->
                        <Border Grid.Row="1" Style="{StaticResource FinancialCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Последние операции" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                                <DataGrid x:Name="dgTransactions"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          RowHeight="35"
                                          MaxHeight="300">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Дата" Width="80" Binding="{Binding Date, StringFormat=dd.MM.yyyy}"/>
                                        <DataGridTextColumn Header="Тип" Width="80" Binding="{Binding Type}"/>
                                        <DataGridTextColumn Header="Сумма" Width="100" Binding="{Binding Amount, StringFormat={}{0:N2}}"/>
                                        <DataGridTextColumn Header="Описание" Width="180" Binding="{Binding Description}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Правая часть - балансы -->
                    <Grid Grid.Column="1" Margin="5,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Остатки по счетам -->
                        <Border Grid.Row="0" Style="{StaticResource FinancialCardStyle}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Остатки по счетам" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Касса:"/>
                                        <TextBlock Grid.Column="1" Text="45,280.50 руб." FontWeight="Bold" Foreground="#2F855A"/>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Расчётный счёт:"/>
                                        <TextBlock Grid.Column="1" Text="1,245,600.75 руб." FontWeight="Bold" Foreground="#2B6CB0"/>
                                    </Grid>
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Итого:" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="1,290,881.25 руб." FontWeight="Bold" FontSize="16" Foreground="#1A202C"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Просроченные счета -->
                        <Border Grid.Row="1" Style="{StaticResource FinancialCardStyle}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="⚠️ Просроченные счета" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" Foreground="#9B2C2C"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Количество:" Margin="0,0,10,0"/>
                                    <TextBlock Text="3" FontWeight="Bold" Foreground="#9B2C2C"/>
                                    <TextBlock Text=" на сумму:" Margin="10,0,10,0"/>
                                    <TextBlock Text="85,400.00 руб." FontWeight="Bold" Foreground="#9B2C2C"/>
                                </StackPanel>
                                <Button Content="📧 Напоминание клиентам" Width="200" Height="35" Margin="0,10,0,0"
                                        Background="#9B2C2C" Foreground="White"/>
                            </StackPanel>
                        </Border>

                        <!-- Кнопки отчётов -->
                        <Border Grid.Row="2" Style="{StaticResource FinancialCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Финансовые отчёты" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                                <Button Content="📊 Оборотная ведомость" Height="40" Margin="0,0,0,10"
                                        Background="#2B6CB0" Foreground="White"/>
                                <Button Content="💰 Отчёт о прибылях и убытках" Height="40" Margin="0,0,0,10"
                                        Background="#2F855A" Foreground="White"/>
                                <Button Content="💸 Отчёт по расходам" Height="40" Margin="0,0,0,10"
                                        Background="#9B2C2C" Foreground="White"/>
                                <Button Content="🏦 Банковская выписка" Height="40"
                                        Background="#4A5568" Foreground="White"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Вкладка 3: Финансовая отчётность -->
            <TabItem Header="📊 Финансовая отчётность">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Период отчёта -->
                    <Border Grid.Row="0" Style="{StaticResource FinancialCardStyle}" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Период отчёта:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <DatePicker Grid.Column="1" Width="150" Height="35" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="2" Text="—" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <DatePicker Grid.Column="3" Width="150" Height="35" Margin="0,0,10,0"/>
                            <Button Grid.Column="4" Content="Сформировать отчёт" Width="150" Height="35"
                                    Background="#2F855A" Foreground="White" Margin="10,0,0,0"/>
                            <Button Grid.Column="5" Content="📥 Экспорт в Excel" Width="150" Height="35"
                                    Background="#2F855A" Foreground="White" Margin="10,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Основные показатели -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource FinancialCardStyle}" Margin="5">
                            <StackPanel>
                                <TextBlock Text="💰 Выручка" FontSize="14" Foreground="#718096" Margin="0,0,0,5"/>
                                <TextBlock Text="1,245,600 руб." FontSize="22" FontWeight="Bold" Foreground="#2F855A"/>
                                <TextBlock Text="+12.5% к прошлому месяцу" FontSize="11" Foreground="#2F855A"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource FinancialCardStyle}" Margin="5">
                            <StackPanel>
                                <TextBlock Text="💸 Расходы" FontSize="14" Foreground="#718096" Margin="0,0,0,5"/>
                                <TextBlock Text="845,320 руб." FontSize="22" FontWeight="Bold" Foreground="#9B2C2C"/>
                                <TextBlock Text="+8.2% к прошлому месяцу" FontSize="11" Foreground="#9B2C2C"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource FinancialCardStyle}" Margin="5">
                            <StackPanel>
                                <TextBlock Text="📈 Прибыль" FontSize="14" Foreground="#718096" Margin="0,0,0,5"/>
                                <TextBlock Text="400,280 руб." FontSize="22" FontWeight="Bold" Foreground="#2F855A"/>
                                <TextBlock Text="+21.3% к прошлому месяцу" FontSize="11" Foreground="#2F855A"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource FinancialCardStyle}" Margin="5">
                            <StackPanel>
                                <TextBlock Text="📊 Маржинальность" FontSize="14" Foreground="#718096" Margin="0,0,0,5"/>
                                <TextBlock Text="32.1%" FontSize="22" FontWeight="Bold" Foreground="#2B6CB0"/>
                                <TextBlock Text="+2.4 п.п." FontSize="11" Foreground="#2F855A"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Вкладка 4: Настройки тарифов -->
            <TabItem Header="⚙️ Настройки тарифов">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Управление тарифами на сырьё"
                               FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>
                    <!-- Таблица тарифов -->
                    <DataGrid Grid.Row="1"
                              x:Name="dgWasteTypes"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              RowHeight="45"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Тип сырья" Width="200" Binding="{Binding TypeName}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Текущая цена" Width="120" Binding="{Binding BasePricePerKg, StringFormat={}{0:N2} руб./кг}"/>
                            <DataGridTextColumn Header="Новая цена" Width="120">
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Background" Value="#F7FAFC"/>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                                <DataGridTextColumn.Binding>
                                    <Binding Path="NewPrice" StringFormat="{}{0:N2}"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Изменение" Width="100">
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                                <DataGridTextColumn.Binding>
                                    <Binding Path="PriceChange" StringFormat="{}{0:+0.00;-0.00;0.00}%"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Действия" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="💾" Width="30" Height="30" Margin="2" ToolTip="Сохранить изменения"/>
                                            <Button Content="↩️" Width="30" Height="30" Margin="2" ToolTip="Отменить изменения"/>
                                            <Button Content="📊" Width="30" Height="30" Margin="2" ToolTip="Анализ цен"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Подвал -->
        <Border Grid.Row="2" Background="#EDF2F7">
            <Grid>
                <TextBlock Text="Бухгалтерия • ООО «ЭкоБумага» • Финансовый учёт и отчётность"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="#4A5568"
                           FontSize="12"/>
                <TextBlock x:Name="txtVersion" Text=""
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="0,0,15,0"
                           Foreground="#718096"
                           FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>