<Window x:Class="EcoBumagaApp.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Панель администратора"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA">

    <Window.Resources>
        <!-- Стиль для заголовков таблиц -->
        <Style x:Key="DataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1F2A38"/>
            <Setter Property="Foreground" Value="#F7FAFC"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <!-- Стиль карточек/блоков -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Direction="320" ShadowDepth="1" BlurRadius="4" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#1F2A38">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Панель администратора"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#F7FAFC"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Grid.Column="0"/>

                <Button x:Name="btnLogout"
                        Content="Выйти"
                        Width="90"
                        Height="34"
                        Margin="0,0,15,0"
                        HorizontalAlignment="Right"
                        Background="#2D3748"
                        Foreground="White"
                        BorderThickness="0"
                        Click="BtnLogout_Click"
                        Grid.Column="1"/>
            </Grid>
        </Border>

        <!-- Основной контент с вкладками -->
        <TabControl Grid.Row="1"
                    Margin="12"
                    Background="White"
                    BorderBrush="#CBD5E0"
                    BorderThickness="1">

            <!-- Вкладка 1: Пользователи -->
            <TabItem Header="👤 Пользователи">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Панель управления -->
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="0,0,0,10">
                        <Button x:Name="btnAddUser"
                                Content="➕ Добавить"
                                Width="110"
                                Height="27"
                                Margin="4"
                                Background="#2B6CB0"
                                Foreground="White"
                                BorderThickness="0"
                                Click="BtnAddUser_Click"/>
                        <Button x:Name="btnEditUser"
                                Content="✏️ Изменить"
                                Width="110"
                                Height="28"
                                Margin="4"
                                Background="#4A5568"
                                Foreground="White"
                                BorderThickness="0"
                                Click="BtnEditUser_Click"/>
                        <Button x:Name="btnDeleteUser"
                                Content="🗑️ Удалить"
                                Width="110"
                                Height="29"
                                Margin="4"
                                Background="#9B2C2C"
                                Foreground="White"
                                BorderThickness="0"
                                Click="BtnDeleteUser_Click"/>
                    </StackPanel>

                    <!-- Таблица пользователей -->
                    <DataGrid x:Name="dgUsers"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              SelectionMode="Single"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              RowHeight="38"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" 
                                                Binding="{Binding UserId}" 
                                                Width="60"
                                                HeaderStyle="{StaticResource DataGridHeaderStyle}"/>
                            <DataGridTextColumn Header="Фамилия" 
                                                Binding="{Binding LastName}" 
                                                Width="120"/>
                            <DataGridTextColumn Header="Имя" 
                                                Binding="{Binding FirstName}" 
                                                Width="110"/>
                            <DataGridTextColumn Header="Отчество" 
                                                Binding="{Binding Patronymic}" 
                                                Width="120"/>
                            <DataGridTextColumn Header="Логин" 
                                                Binding="{Binding Login}" 
                                                Width="130"/>
                            <DataGridTextColumn Header="Роль" 
                                                Binding="{Binding Role.RoleName}" 
                                                Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Вкладка 2: Сотрудники -->
            <TabItem Header="👥 Сотрудники">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Панель управления -->
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="0,0,0,10">
                        <Button x:Name="btnAddEmployee"
                                Content="➕ Добавить"
                                Width="110"
                                Height="27"
                                Margin="4"
                                Background="#2B6CB0"
                                Foreground="White"
                                BorderThickness="0"
                                Click="BtnAddEmployee_Click"/>
                        <Button x:Name="btnEditEmployee"
                                Content="✏️ Изменить"
                                Width="110"
                                Height="29"
                                Margin="4"
                                Background="#4A5568"
                                Foreground="White"
                                BorderThickness="0"
                                Click="BtnEditEmployee_Click"/>
                        <Button x:Name="btnDeleteEmployee"
                                Content="🗑️ Удалить"
                                Width="110"
                                Height="28"
                                Margin="4"
                                Background="#9B2C2C"
                                Foreground="White"
                                BorderThickness="0"
                                Click="BtnDeleteEmployee_Click"/>
                    </StackPanel>

                    <!-- Таблица сотрудников -->
                    <DataGrid x:Name="dgEmployees"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              SelectionMode="Single"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              RowHeight="38"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" 
                                                Binding="{Binding EmployeeId}" 
                                                Width="60"
                                                HeaderStyle="{StaticResource DataGridHeaderStyle}"/>
                            <DataGridTextColumn Header="ФИО" 
                                                Width="240">
                                <DataGridTextColumn.Binding>
                                    <MultiBinding StringFormat="{}{0} {1} {2}">
                                        <Binding Path="User.LastName"/>
                                        <Binding Path="User.FirstName"/>
                                        <Binding Path="User.Patronymic"/>
                                    </MultiBinding>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Табельный номер" 
                                                Binding="{Binding EmployeeNumber}" 
                                                Width="130"/>
                            <DataGridTextColumn Header="Должность" 
                                                Binding="{Binding Position.PositionName}" 
                                                Width="170"/>
                            <DataGridTextColumn Header="Дата приёма" 
                                                Binding="{Binding HireDate, StringFormat=dd.MM.yyyy}" 
                                                Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>