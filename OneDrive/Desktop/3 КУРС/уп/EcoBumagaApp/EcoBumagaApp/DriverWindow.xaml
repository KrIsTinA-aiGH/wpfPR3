<Window x:Class="EcoBumagaApp.DriverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Приложение водителя-экспедитора"
        Height="720"
        Width="1020"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA">

    <Window.Resources>
        <!-- Стиль карточек -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Direction="320" ShadowDepth="1" BlurRadius="4" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль кнопок действий -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Стиль индикатора статуса -->
        <Style x:Key="StatusIndicatorStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="110"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#1F2A38">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Информация о водителе -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                    <TextBlock Text="🚛" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock x:Name="txtDriverName" Text=""
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="Medium"/>
                        <TextBlock Text="ГАЗель Next • А001АА777"
                                   Foreground="#CBD5E0"
                                   FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <!-- Текущий статус -->
                <Border Grid.Column="1"
                        Background="#2B6CB0"
                        CornerRadius="12"
                        Padding="16,6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📍" FontSize="16" Margin="0,0,8,0" Foreground="White"/>
                        <TextBlock x:Name="txtCurrentStatus" Text="На маршруте"
                                   Foreground="White"
                                   FontWeight="Medium"/>
                    </StackPanel>
                </Border>

                <!-- Кнопки -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button x:Name="btnStartDay" Content="▶️ Начать день" Width="130" Height="36" Margin="5"
                            Background="#2F855A" Foreground="White" Style="{StaticResource ActionButtonStyle}"/>
                    <Button x:Name="btnLogout" Content="Выйти" Width="80" Height="36" Margin="5"
                            Background="#2D3748" Foreground="White" Style="{StaticResource ActionButtonStyle}" Click="BtnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основной контент -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая часть - текущая задача и детали -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Карточка текущей задачи -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Иконка и номер -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="📍" FontSize="34" Foreground="#2B6CB0"/>
                            <TextBlock Text="#103" FontWeight="Medium" HorizontalAlignment="Center" Foreground="#2D3748"/>
                        </StackPanel>

                        <!-- Информация -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Текущая заявка" FontSize="13" Foreground="#718096"/>
                            <TextBlock Text="ул. Садовая, 12, г. Химки" FontSize="16" FontWeight="Medium" Margin="0,4,0,0"/>
                            <TextBlock Text="ООО 'Ромашка' • +7 (495) 123-45-69" Foreground="#2B6CB0" Margin="0,6,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="📦 500 кг" Margin="0,0,16,0" FontWeight="Medium"/>
                                <TextBlock Text="📄 Бумага офисная" Margin="0,0,16,0" FontWeight="Medium"/>
                                <TextBlock Text="⏰ 09:00–11:00" FontWeight="Medium"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Статус и действия -->
                        <StackPanel Grid.Column="2" Width="220">
                            <Border Style="{StaticResource StatusIndicatorStyle}" Background="#9B2C2C" Margin="0,0,0,12">
                                <TextBlock Text="Ожидает" Foreground="White" FontWeight="Medium"/>
                            </Border>
                            <Button Content="📍 Начать погрузку"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Background="#2F855A" Foreground="White" Margin="0,0,0,8"/>
                            <Button Content="ℹ️ Детали"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Background="#4A5568" Foreground="White"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Детали выполнения -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="📝 Детали выполнения" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <StackPanel Grid.Row="1">
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Фактический вес (кг):" Margin="0,0,0,6" Foreground="#4A5568"/>
                                    <TextBox x:Name="txtActualWeight" Text="500" Height="40" Padding="10" FontSize="14"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                    <TextBlock Text="Категория качества:" Margin="0,0,0,6" Foreground="#4A5568"/>
                                    <ComboBox x:Name="cbQuality" Height="34" SelectedIndex="0">
                                        <ComboBoxItem Content="A - Отличное"/>
                                        <ComboBoxItem Content="B - Хорошее"/>
                                        <ComboBoxItem Content="C - Среднее"/>
                                        <ComboBoxItem Content="D - Плохое"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Примечания:" Margin="0,0,0,6" Foreground="#4A5568"/>
                                <TextBox x:Name="txtNotes" Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                                         Text="Упаковка целая, сырьё сухое" Padding="10"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Content="📸 Сделать фото" Width="150" Height="40" Margin="0,0,12,0"
                                        Style="{StaticResource ActionButtonStyle}" Background="#4A5568" Foreground="White"/>
                                <Button Content="✍️ Подпись клиента" Width="160" Height="40" Margin="0,0,12,0"
                                        Style="{StaticResource ActionButtonStyle}" Background="#2B6CB0" Foreground="White"/>
                                <Button x:Name="btnComplete" Content="✅ Завершить заявку" Width="170" Height="40"
                                        Style="{StaticResource ActionButtonStyle}" Background="#2F855A" Foreground="White"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Правая часть - маршрут и статистика -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Карточка маршрута -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="🗺️ Маршрут на сегодня" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Прогресс: 2/5 заявок" FontSize="13" Foreground="#718096"/>
                            <ProgressBar Value="40" Height="16" Margin="0,6,0,0" Foreground="#2B6CB0"/>
                        </StackPanel>

                        <StackPanel>
                            <Border Padding="12" Background="#F7FAFC" CornerRadius="5" Margin="0,0,0,6">
                                <Grid>
                                    <TextBlock Text="1. ✅ ул. Ленина, 10" FontWeight="Medium"/>
                                    <TextBlock Text="09:15" HorizontalAlignment="Right" Foreground="#2F855A"/>
                                </Grid>
                            </Border>
                            <Border Padding="12" Background="#F7FAFC" CornerRadius="5" Margin="0,0,0,6">
                                <Grid>
                                    <TextBlock Text="2. ✅ пр. Мира, 25" FontWeight="Medium"/>
                                    <TextBlock Text="10:30" HorizontalAlignment="Right" Foreground="#2F855A"/>
                                </Grid>
                            </Border>
                            <Border Padding="12" Background="#EDF2F7" CornerRadius="5" Margin="0,0,0,6" BorderBrush="#2B6CB0" BorderThickness="1">
                                <Grid>
                                    <TextBlock Text="3. 🚛 ул. Садовая, 12" FontWeight="Medium"/>
                                    <TextBlock Text="Текущая" HorizontalAlignment="Right" Foreground="#2B6CB0" FontWeight="Medium"/>
                                </Grid>
                            </Border>
                            <Border Padding="12" Background="#F7FAFC" CornerRadius="5" Margin="0,0,0,6">
                                <TextBlock Text="4. ул. Промышленная, 8" Foreground="#718096"/>
                            </Border>
                            <Border Padding="12" Background="#F7FAFC" CornerRadius="5">
                                <TextBlock Text="5. ул. Заводская, 15" Foreground="#718096"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Статистика -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="📊 Сегодняшняя статистика" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Собрано сырья:" FontSize="13" Foreground="#718096"/>
                            <TextBlock Text="650 кг" FontSize="24" FontWeight="Medium" Foreground="#2F855A"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Затраченное время:" FontSize="13" Foreground="#718096"/>
                            <TextBlock Text="3 ч 45 мин" FontSize="20" FontWeight="Medium"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Пробег:" FontSize="13" Foreground="#718096"/>
                            <TextBlock Text="78 км" FontSize="20" FontWeight="Medium"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Бонусы за день:" FontSize="13" Foreground="#718096"/>
                            <TextBlock Text="+ 85 баллов" FontSize="20" FontWeight="Medium" Foreground="#2B6CB0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Подвал с быстрыми действиями -->
        <Border Grid.Row="2" Background="#1F2A38" Padding="12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="📞 Связь с диспетчером" Width="170" Height="42" Margin="6"
                        Style="{StaticResource ActionButtonStyle}" Background="#2B6CB0" Foreground="White"/>
                <Button Content="🚨 Проблема в пути" Width="160" Height="42" Margin="6"
                        Style="{StaticResource ActionButtonStyle}" Background="#9B2C2C" Foreground="White"/>
                <Button Content="🔄 Обновить маршрут" Width="160" Height="42" Margin="6"
                        Style="{StaticResource ActionButtonStyle}" Background="#4A5568" Foreground="White"/>
                <Button Content="ℹ️ Помощь" Width="130" Height="42" Margin="6"
                        Style="{StaticResource ActionButtonStyle}" Background="#718096" Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>