<Window x:Class="EcoBumagaApp.GuestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ЭкоБумага - Приём макулатуры"
        Height="820"
        Width="1220"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA">

    <Window.Resources>
        <!-- Стиль информационных карточек -->
        <Style x:Key="InfoCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Direction="320" ShadowDepth="1" BlurRadius="4" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль карточек цен -->
        <Style x:Key="PriceCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Width" Value="190"/>
            <Setter Property="Height" Value="130"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Direction="320" ShadowDepth="1" BlurRadius="4" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#1F2A38">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Логотип -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                    <TextBlock Text="🌿" FontSize="28" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="ЭКОБУМАГА"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="Приём макулатуры и картона"
                                   FontSize="11"
                                   Foreground="#CBD5E0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Навигация -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="🏠 Главная" Width="100" Height="36" Margin="4" 
                            Background="Transparent" Foreground="White" BorderThickness="0"/>
                    <Button Content="💰 Цены" Width="100" Height="36" Margin="4" 
                            Background="Transparent" Foreground="White" BorderThickness="0"/>
                    <Button Content="📍 Пункты" Width="100" Height="36" Margin="4" 
                            Background="Transparent" Foreground="White" BorderThickness="0"/>
                    <Button Content="📋 Заявка" Width="100" Height="36" Margin="4" 
                            Background="Transparent" Foreground="White" BorderThickness="0"/>
                    <Button Content="📞 Контакты" Width="100" Height="36" Margin="4" 
                            Background="Transparent" Foreground="White" BorderThickness="0"/>
                </StackPanel>

                <!-- Кнопки входа -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Content="Вход" Width="90" Height="36" Margin="5"
                            Background="#2B6CB0" Foreground="White"/>
                    <Button Content="Регистрация" Width="110" Height="36" Margin="5"
                            Background="#4A5568" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основной контент -->
        <TabControl Grid.Row="1" Margin="15" Background="White" BorderBrush="#CBD5E0" BorderThickness="1">

            <!-- Вкладка 1: Главная -->
            <TabItem Header="🏠 Главная">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Приветствие -->
                    <Border Grid.Row="0" Style="{StaticResource InfoCardStyle}" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Сдавайте макулатуру — получайте деньги!"
                                       FontSize="22" FontWeight="SemiBold" Foreground="#2F855A" Margin="0,0,0,12"/>
                            <TextBlock Text="Мы принимаем бумагу, картон, архивы по выгодным ценам. Бесплатный вывоз от 50 кг. Экологично и прибыльно!"
                                       FontSize="14" TextWrapping="Wrap" Foreground="#4A5568"/>
                        </StackPanel>
                    </Border>

                    <!-- Быстрые действия -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Рассчитать стоимость -->
                        <Border Grid.Column="0" Style="{StaticResource InfoCardStyle}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="🧮 Рассчитать стоимость" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <ComboBox Width="220" Height="36" Margin="0,0,0,12" SelectedIndex="0">
                                    <ComboBoxItem Content="Выберите тип сырья"/>
                                    <ComboBoxItem Content="Офисная бумага"/>
                                    <ComboBoxItem Content="Картон"/>
                                    <ComboBoxItem Content="Газетная бумага"/>
                                    <ComboBoxItem Content="Журналы"/>
                                </ComboBox>
                                <TextBlock Text="Вес (кг):" Margin="0,0,0,6" Foreground="#4A5568"/>
                                <TextBox Width="220" Height="36" Text="10" Margin="0,0,0,12"/>
                                <Button Content="Рассчитать" Width="220" Height="38"
                                        Background="#2B6CB0" Foreground="White" FontWeight="Medium"/>
                                <TextBlock x:Name="txtCalculationResult" Text="" FontWeight="Medium" Foreground="#2F855A" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Быстрая заявка -->
                        <Border Grid.Column="1" Style="{StaticResource InfoCardStyle}" Margin="6,0">
                            <StackPanel>
                                <TextBlock Text="🚚 Быстрая заявка" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <TextBlock Text="Оставьте заявку на вывоз макулатуры. Мы перезвоним в течение 30 минут."
                                           TextWrapping="Wrap" Margin="0,0,0,16" Foreground="#4A5568"/>
                                <Button Content="📋 Оставить заявку" Width="220" Height="40"
                                        Background="#2B6CB0" Foreground="White" FontWeight="Medium"
                                        HorizontalAlignment="Center"/>
                                <TextBlock Text="Без регистрации" FontSize="12" Foreground="#718096" 
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Контакты -->
                        <Border Grid.Column="2" Style="{StaticResource InfoCardStyle}" Margin="12,0,0,0">
                            <StackPanel>
                                <TextBlock Text="📞 Контакты" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Телефон:" FontWeight="Medium"/>
                                    <TextBlock Text="+7 (495) 123-45-67" Foreground="#2B6CB0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Email:" FontWeight="Medium"/>
                                    <TextBlock Text="info@ecobumaga.ru" Foreground="#2B6CB0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Часы работы:" FontWeight="Medium"/>
                                    <TextBlock Text="Пн–Пт: 9:00–18:00" FontSize="12"/>
                                    <TextBlock Text="Сб: 10:00–16:00" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Вкладка 2: Цены -->
            <TabItem Header="💰 Цены">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Текущие закупочные цены"
                               FontSize="20" FontWeight="SemiBold" Foreground="#1F2A38" Margin="0,0,0,16"/>

                    <WrapPanel Grid.Row="1" Orientation="Horizontal">
                        <!-- Офисная бумага -->
                        <Border Style="{StaticResource PriceCardStyle}" Height="141">
                            <StackPanel>
                                <TextBlock Text="📄" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Офисная" FontWeight="Medium" HorizontalAlignment="Center"/>
                                <TextBlock Text="7.00 руб/кг" FontSize="18" FontWeight="Medium" Foreground="#2F855A" 
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Text="Категория A" FontSize="12" Foreground="#718096" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Картон -->
                        <Border Style="{StaticResource PriceCardStyle}" Height="135">
                            <StackPanel>
                                <TextBlock Text="📦" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Картон" FontWeight="Medium" HorizontalAlignment="Center"/>
                                <TextBlock Text="4.00 руб/кг" FontSize="18" FontWeight="Medium" Foreground="#2F855A" 
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Text="Сухой, чистый" FontSize="12" Foreground="#718096" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Газетная бумага -->
                        <Border Style="{StaticResource PriceCardStyle}" Height="135">
                            <StackPanel>
                                <TextBlock Text="📰" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Газетная" FontWeight="Medium" HorizontalAlignment="Center"/>
                                <TextBlock Text="5.00 руб/кг" FontSize="18" FontWeight="Medium" Foreground="#2F855A" 
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Text="Без рекламы" FontSize="12" Foreground="#718096" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Журналы -->
                        <Border Style="{StaticResource PriceCardStyle}" Height="135">
                            <StackPanel>
                                <TextBlock Text="📚" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Журналы" FontWeight="Medium" HorizontalAlignment="Center"/>
                                <TextBlock Text="3.50 руб/кг" FontSize="18" FontWeight="Medium" Foreground="#2F855A" 
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Text="Глянцевые" FontSize="12" Foreground="#718096" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Архивная -->
                        <Border Style="{StaticResource PriceCardStyle}" Height="135">
                            <StackPanel>
                                <TextBlock Text="🗃️" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Архивная" FontWeight="Medium" HorizontalAlignment="Center"/>
                                <TextBlock Text="6.00 руб/кг" FontSize="18" FontWeight="Medium" Foreground="#2F855A" 
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Text="Конфиденциально" FontSize="12" Foreground="#718096" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </Grid>
            </TabItem>

            <!-- Вкладка 3: Пункты приёма -->
            <TabItem Header="📍 Пункты">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Наши пункты приёма"
                               FontSize="20" FontWeight="SemiBold" Foreground="#1F2A38" Margin="0,0,0,16"/>

                    <DataGrid Grid.Row="1"
                              x:Name="dgReceptionPoints"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              RowHeight="42">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Адрес" Width="340" Binding="{Binding Address}"/>
                            <DataGridTextColumn Header="Телефон" Width="140" Binding="{Binding Phone}"/>
                            <DataGridTextColumn Header="Часы работы" Width="170" Binding="{Binding WorkingHours}"/>
                            <DataGridTextColumn Header="Район" Width="140" Binding="{Binding District}"/>
                            <DataGridTemplateColumn Header="Действия" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="🗺️" Width="34" Height="34" Margin="4" ToolTip="На карте"/>
                                            <Button Content="📞" Width="34" Height="34" Margin="4" ToolTip="Позвонить"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Вкладка 4: Оформление заявки -->
            <TabItem Header="📋 Заявка">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Оформление заявки"
                               FontSize="20" FontWeight="SemiBold" Foreground="#1F2A38" Margin="0,0,0,16"/>

                    <Border Grid.Row="1" Style="{StaticResource InfoCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Левая часть - данные клиента -->
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="👤 Ваши данные" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <TextBlock Text="ФИО:*" Margin="0,0,0,6" Foreground="#4A5568"/>
                                <TextBox x:Name="txtGuestName" Height="36" Margin="0,0,0,12"/>
                                <TextBlock Text="Телефон:*" Margin="0,0,0,6" Foreground="#4A5568"/>
                                <TextBox x:Name="txtGuestPhone" Height="36" Margin="0,0,0,12"/>
                                <TextBlock Text="Email:" Margin="0,0,0,6" Foreground="#4A5568"/>
                                <TextBox x:Name="txtGuestEmail" Height="36" Margin="0,0,0,12"/>
                                <TextBlock Text="Адрес вывоза/приёма:*" Margin="0,0,0,6" Foreground="#4A5568"/>
                                <TextBox x:Name="txtGuestAddress" Height="70" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,12"/>
                            </StackPanel>

                            <!-- Правая часть - данные заявки -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="📦 Данные о сырье" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <TextBlock Text="Тип сырья:*" Margin="0,0,0,6" Foreground="#4A5568"/>
                                <ComboBox x:Name="cmbWasteType" Height="36" Margin="0,0,0,12"/>
                                <TextBlock Text="Ориентировочный вес (кг):*" Margin="0,0,0,6" Foreground="#4A5568"/>
                                <TextBox x:Name="txtWeight" Height="36" Text="10" Margin="0,0,0,12"/>
                                <TextBlock Text="Тип заявки:*" Margin="0,0,0,6" Foreground="#4A5568"/>
                                <ComboBox x:Name="cmbApplicationType" Height="36" Margin="0,0,0,12">
                                    <ComboBoxItem Content="Самовывоз"/>
                                    <ComboBoxItem Content="Вывоз компанией"/>
                                </ComboBox>
                                <TextBlock Text="Предпочтительная дата:" Margin="0,0,0,6" Foreground="#4A5568"/>
                                <DatePicker x:Name="dpPreferredDate" Height="36" Margin="0,0,0,20"/>
                                <Button Content="✅ Отправить заявку" Width="240" Height="42"
                                        Background="#2F855A" Foreground="White" FontWeight="Medium"
                                        HorizontalAlignment="Left"/>
                                <TextBlock Text="* — обязательные поля" FontSize="12" Foreground="#718096" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Вкладка 5: Правила -->
            <TabItem Header="📝 Правила">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Правила приёма сырья"
                               FontSize="20" FontWeight="SemiBold" Foreground="#1F2A38" Margin="0,0,0,16"/>

                    <Border Grid.Row="1" Style="{StaticResource InfoCardStyle}">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="✅ Что принимаем:" FontWeight="Medium" Margin="0,0,0,8"/>
                                <TextBlock Text="• Офисная бумага А4 (белая, без скрепок и скобок)" Margin="20,0,0,4"/>
                                <TextBlock Text="• Картон (коробки, упаковка, сухой и чистый)" Margin="20,0,0,4"/>
                                <TextBlock Text="• Газеты и журналы (без плёнки)" Margin="20,0,0,4"/>
                                <TextBlock Text="• Архивная документация (уничтожение с актом)" Margin="20,0,0,4"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="❌ Что не принимаем:" FontWeight="Medium" Margin="0,0,0,8"/>
                                <TextBlock Text="• Влажное или горелое сырьё" Margin="20,0,0,4"/>
                                <TextBlock Text="• Сырьё с пищевыми отходами" Margin="20,0,0,4"/>
                                <TextBlock Text="• Ламинированная бумага" Margin="20,0,0,4"/>
                                <TextBlock Text="• Обои, фотобумага" Margin="20,0,0,4"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="📦 Требования к упаковке:" FontWeight="Medium" Margin="0,0,0,8"/>
                                <TextBlock Text="• Картон в сложенном виде" Margin="20,0,0,4"/>
                                <TextBlock Text="• Бумага в коробках или перевязанная" Margin="20,0,0,4"/>
                                <TextBlock Text="• Отдельно разные типы сырья" Margin="20,0,0,4"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="💰 Оплата:" FontWeight="Medium" Margin="0,0,0,8"/>
                                <TextBlock Text="• Наличными в пункте приёма" Margin="20,0,0,4"/>
                                <TextBlock Text="• На карту (по договорённости)" Margin="20,0,0,4"/>
                                <TextBlock Text="• Безналичный расчёт для организаций" Margin="20,0,0,4"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>