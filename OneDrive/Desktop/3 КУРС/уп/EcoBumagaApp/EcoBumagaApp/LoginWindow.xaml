<Window x:Class="EcoBumagaApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в систему"
        Height="420"
        Width="380"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Стиль меток -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#4A5568"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>

        <!-- Стиль полей ввода -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Стиль кнопок -->
        <Style TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="0,0,0,7">
        <Border Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Width="320" Height="404">


            <StackPanel>
                <!-- Заголовок -->
                <TextBlock Text="Вход в систему"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#1F2A38"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24"/>

                <!-- Логин -->
                <TextBlock Text="Логин" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="txtLogin" Margin="0,0,0,16"/>

                <!-- Пароль -->
                <TextBlock Text="Пароль" Style="{StaticResource LabelStyle}"/>
                <PasswordBox x:Name="txtPassword" Margin="0,0,0,24"/>

                <!-- Кнопка Войти -->
                <Button x:Name="btnLogin"
                        Content="Войти"
                        Background="#2B6CB0"
                        Foreground="White"
                        Click="BtnLogin_Click"/>

                <!-- Кнопка Гость -->
                <Button x:Name="btnGuest"
                        Content="Продолжить как гость"
                        Background="#4A5568"
                        Foreground="White"
                        Margin="0,12,0,0"
                        Click="BtnGuest_Click" Height="32"/>

                <!-- Ошибка -->
                <TextBlock x:Name="txtError"
                           Foreground="#9B2C2C"
                           FontWeight="Medium"
                           Margin="0,16,0,0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>