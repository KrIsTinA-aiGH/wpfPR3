<Window x:Class="EcoBumagaApp.OperatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Окно оператора"
        Height="680"
        Width="920"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA">

    <Window.Resources>
        <!-- Стиль заголовков таблицы -->
        <Style x:Key="DataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1F2A38"/>
            <Setter Property="Foreground" Value="#F7FAFC"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <!-- Стиль карточек -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Direction="320" ShadowDepth="1" BlurRadius="4" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#1F2A38">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Название -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                    <TextBlock Text="📋" FontSize="28" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="УПРАВЛЕНИЕ ЗАЯВКАМИ"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Кнопка выхода -->
                <Button x:Name="btnLogout"
                        Content="Выйти"
                        Width="90"
                        Height="36"
                        Margin="0,0,15,0"
                        HorizontalAlignment="Right"
                        Background="#2D3748"
                        Foreground="White"
                        Click="BtnLogout_Click"
                        Grid.Column="2"/>
            </Grid>
        </Border>

        <!-- Основной контент -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Панель управления -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <WrapPanel Orientation="Horizontal">
                    <Button x:Name="btnAddApplication"
                            Content="➕ Новая заявка"
                            Width="140"
                            Height="38"
                            Margin="4"
                            Background="#2F855A"
                            Foreground="White"
                            Click="BtnAddApplication_Click"/>
                    <Button x:Name="btnEditApplication"
                            Content="✏️ Изменить"
                            Width="110"
                            Height="38"
                            Margin="4"
                            Background="#2B6CB0"
                            Foreground="White"
                            Click="BtnEditApplication_Click"/>
                    <Button x:Name="btnDeleteApplication"
                            Content="🗑️ Удалить"
                            Width="110"
                            Height="38"
                            Margin="4"
                            Background="#9B2C2C"
                            Foreground="White"
                            Click="BtnDeleteApplication_Click"/>
                    <ComboBox x:Name="cbFilterStatus"
                              Width="160"
                              Height="38"
                              Margin="4"
                              SelectionChanged="CbFilterStatus_SelectionChanged">
                        <ComboBoxItem Content="Все статусы" Tag="ALL"/>
                    </ComboBox>
                </WrapPanel>
            </Border>

            <!-- Таблица заявок -->
            <DataGrid Grid.Row="1"
                      x:Name="dgApplications"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      RowHeight="42"
                      Margin="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding ApplicationId}" Width="70" HeaderStyle="{StaticResource DataGridHeaderStyle}"/>
                    <DataGridTextColumn Header="Клиент" Width="220">
                        <DataGridTextColumn.Binding>
                            <MultiBinding StringFormat="{}{0} {1}">
                                <Binding Path="ClientUser.LastName"/>
                                <Binding Path="ClientUser.FirstName"/>
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Адрес" Binding="{Binding SourceAddress}" Width="260"/>
                    <DataGridTextColumn Header="Способ" Binding="{Binding SourceType.SourceTypeName}" Width="130"/>
                    <DataGridTextColumn Header="Вес (кг)" Binding="{Binding EstimatedWeight}" Width="90"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding Status.StatusName}" Width="130">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Дата создания" Binding="{Binding CreatedDate, StringFormat=dd.MM.yyyy}" Width="110" HeaderStyle="{StaticResource DataGridHeaderStyle}"/>
                    <DataGridTextColumn Header="Бонусы" Binding="{Binding BonusesAwarded}" Width="90" HeaderStyle="{StaticResource DataGridHeaderStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Подвал -->
        <Border Grid.Row="2" Background="#EDF2F7">
            <TextBlock Text="Оператор приёмного пункта • ООО «ЭкоБумага»"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="#4A5568"
                       FontSize="12"/>
        </Border>
    </Grid>
</Window>