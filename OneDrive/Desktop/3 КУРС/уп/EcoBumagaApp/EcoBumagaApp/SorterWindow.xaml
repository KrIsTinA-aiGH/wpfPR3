<Window x:Class="EcoBumagaApp.SorterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Цех сортировки"
        Height="880"
        Width="1320"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA">

    <Window.Resources>
        <!-- Стиль карточек-->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D9E0"/>
            <Setter Property="Margin" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000"
                                      Direction="315"
                                      ShadowDepth="2"
                                      BlurRadius="12"
                                      Opacity="0.18"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль бейджа качества/статуса -->
        <Style x:Key="QualityBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="110"/>
        </Style>

        <!-- Стиль кнопок типов сырья -->
        <Style x:Key="TypeButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#2D3748"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#1F2A38">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Логотип и название -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                    <TextBlock Text="📊" FontSize="28" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="ЦЕХ СОРТИРОВКИ И КЛАССИФИКАЦИИ"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="Обработка и категоризация сырья"
                                   FontSize="11"
                                   Foreground="#CBD5E0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Информация о сортировщике -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock x:Name="txtSorterName" Text=""
                               Foreground="White"
                               FontSize="16"
                               HorizontalAlignment="Right"/>
                    <TextBlock Text="Линия сортировки №2 • Смена дневная"
                               Foreground="#CBD5E0"
                               FontSize="11"
                               HorizontalAlignment="Right"/>
                </StackPanel>

                <!-- Кнопки -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Content="📈 Продуктивность" Width="160" Height="36" Margin="5"
                            Background="#2B6CB0" Foreground="White"/>
                    <Button Content="📋 Отчёт о браке" Width="150" Height="36" Margin="5"
                            Background="#9B2C2C" Foreground="White"/>
                    <Button x:Name="btnLogout" Content="Выйти" Width="80" Height="36" Margin="5"
                            Background="#2D3748" Foreground="White" Click="BtnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основной контент -->
        <Grid Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая часть - сортировка текущей партии -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Информация о текущей партии -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="🎯" FontSize="34"/>
                            <TextBlock Text="П-015" FontWeight="Medium" HorizontalAlignment="Center" FontSize="14"/>
                            <TextBlock Text="Новая" Foreground="#2F855A" FontWeight="Medium" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Партия от 15.03.2026 14:30" FontWeight="Medium" FontSize="16"/>
                            <TextBlock Text="Приёмщик: Смирнов И.П." Foreground="#718096" Margin="0,6,0,0"/>
                            <TextBlock Text="Вес на входе: 645 кг" FontWeight="Medium" Margin="0,6,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Border Style="{StaticResource QualityBadgeStyle}" Background="#4A5568" Margin="0,0,8,0">
                                    <TextBlock Text="Смешанная" Foreground="White" FontSize="12"/>
                                </Border>
                                <Border Style="{StaticResource QualityBadgeStyle}" Background="#B7791F">
                                    <TextBlock Text="Предварительная оценка: B" Foreground="White" FontSize="12"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Width="260" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Прогресс сортировки:" FontWeight="Medium" Foreground="#4A5568"/>
                                <ProgressBar Value="35" Height="18" Margin="0,8,0,8" Foreground="#2B6CB0"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Обработано:" FontSize="13"/>
                                    <TextBlock Grid.Column="1" Text="225 кг" HorizontalAlignment="Right" FontWeight="Medium"/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Осталось:" FontSize="13"/>
                                    <TextBlock Grid.Column="1" Text="420 кг" HorizontalAlignment="Right" FontWeight="Medium"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Форма сортировки -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="📋 Форма сортировки и классификации"
                                   FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16"/>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Тип сырья -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                                <TextBlock Text="Тип сырья:" FontWeight="Medium" Foreground="#4A5568" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <Button Content="📄 Офисная бумага" Style="{StaticResource TypeButtonStyle}"
                                            BorderBrush="#2B6CB0" Foreground="#2B6CB0" Width="170" Margin="0,0,12,12"/>
                                    <Button Content="📰 Газетная бумага" Style="{StaticResource TypeButtonStyle}"
                                            BorderBrush="#4A5568" Foreground="#4A5568" Width="170" Margin="0,0,12,12"/>
                                    <Button Content="📦 Картон" Style="{StaticResource TypeButtonStyle}"
                                            BorderBrush="#2F855A" Foreground="#2F855A" Width="150" Margin="0,0,12,12"/>
                                    <Button Content="📚 Журналы" Style="{StaticResource TypeButtonStyle}"
                                            BorderBrush="#718096" Foreground="#718096" Width="150" Margin="0,0,12,12"/>
                                    <Button Content="🗃️ Архивная" Style="{StaticResource TypeButtonStyle}"
                                            BorderBrush="#9B2C2C" Foreground="#9B2C2C" Width="150"/>
                                </WrapPanel>
                            </StackPanel>

                            <!-- Категория качества -->
                            <StackPanel Grid.Row="1" Margin="0,0,0,20">
                                <TextBlock Text="Категория качества:" FontWeight="Medium" Foreground="#4A5568" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="A - Отличное" GroupName="Quality" Margin="0,0,20,0"
                                                 FontWeight="Medium" Foreground="#2F855A"/>
                                    <RadioButton Content="B - Хорошее" GroupName="Quality" Margin="0,0,20,0"
                                                 FontWeight="Medium" Foreground="#2B6CB0" IsChecked="True"/>
                                    <RadioButton Content="C - Среднее" GroupName="Quality" Margin="0,0,20,0"
                                                 FontWeight="Medium" Foreground="#B7791F"/>
                                    <RadioButton Content="D - Плохое" GroupName="Quality"
                                                 FontWeight="Medium" Foreground="#9B2C2C"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Загрязнения -->
                            <StackPanel Grid.Row="2" Margin="0,0,0,20">
                                <TextBlock Text="Обнаруженные загрязнения:" FontWeight="Medium" Foreground="#4A5568" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <CheckBox Content="Пластик" Margin="0,0,20,8"/>
                                    <CheckBox Content="Металл" Margin="0,0,20,8"/>
                                    <CheckBox Content="Стекло" Margin="0,0,20,8"/>
                                    <CheckBox Content="Пищевые отходы" Margin="0,0,20,8"/>
                                    <CheckBox Content="Влажность" Margin="0,0,20,8" IsChecked="True"/>
                                    <CheckBox Content="Плесень" Margin="0,0,20,8"/>
                                    <CheckBox Content="Краска/чернила" IsChecked="True"/>
                                </WrapPanel>
                            </StackPanel>

                            <!-- Взвешивание и маркировка -->
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Вес отсортированной партии:" FontWeight="Medium" Foreground="#4A5568" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="txtSortedWeight" Text="85.5" Height="36" Padding="10"/>
                                        <TextBlock Grid.Column="1" Text="кг" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="Medium"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                    <TextBlock Text="Номер маркировки:" FontWeight="Medium" Foreground="#4A5568" Margin="0,0,0,8"/>
                                    <TextBox x:Name="txtMarkingNumber" Text="S-2026-02-07-001" Height="36" Padding="10"/>
                                </StackPanel>

                                <Button Grid.Column="2" Content="➕ Добавить в паллету"
                                        Width="200" Height="42" Margin="20,20,0,0"
                                        Background="#2F855A" Foreground="White"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Правая часть - паллеты и статистика -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Текущие паллеты -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="📦 Формируемые паллеты" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <StackPanel>
                            <!-- Паллета 1 -->
                            <Border Padding="14" Background="#F7FAFC" CornerRadius="6" Margin="0,0,0,10" BorderBrush="#2B6CB0" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="📄" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Паллета #1 • Офисная бумага" FontWeight="Medium"/>
                                        <TextBlock Text="Категория A • 245 кг" Foreground="#718096" FontSize="13"/>
                                        <TextBlock Text="Маркировка: S-2026-02-07-001" Foreground="#2B6CB0" FontSize="12"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="85%" VerticalAlignment="Center" FontWeight="Medium" Foreground="#2F855A"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <Button Content="✅ Отправить на прессование"
                                Width="240" Height="42" Margin="0,16,0,0"
                                Background="#2F855A" Foreground="White"/>
                    </StackPanel>
                </Border>

                <!-- Статистика смены -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="📊 Статистика за смену" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Обработано сырья:" FontSize="13" Foreground="#718096"/>
                            <TextBlock Text="520 кг" FontSize="24" FontWeight="Medium" Foreground="#2F855A"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Эффективность сортировки:" FontSize="13" Foreground="#718096"/>
                            <ProgressBar Value="87" Height="18" Margin="0,8,0,0" Foreground="#2B6CB0"/>
                            <TextBlock Text="87%" HorizontalAlignment="Right" FontWeight="Medium" Foreground="#2B6CB0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Процент брака:" FontSize="13" Foreground="#718096"/>
                            <ProgressBar Value="5" Height="18" Margin="0,8,0,0" Foreground="#9B2C2C"/>
                            <TextBlock Text="5%" HorizontalAlignment="Right" FontWeight="Medium" Foreground="#9B2C2C"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Рекомендации по ценообразованию:" FontSize="13" Foreground="#718096"/>
                            <Border Padding="12" Background="#F7FAFC" CornerRadius="6" Margin="0,8,0,0">
                                <TextBlock Text="Повысить цену на категорию A на 3% из-за высокого качества"
                                           FontSize="12" Foreground="#2D3748"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Контроль влажности -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="💧 Контроль влажности" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Текущая влажность:" FontSize="13"/>
                                <TextBlock Text="12.5%" FontSize="22" FontWeight="Medium" Foreground="#2B6CB0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Норма: ≤ 15%" FontSize="12" Foreground="#2F855A"/>
                                <TextBlock Text="⚠️ При превышении 18% требуется сушка" FontSize="11" Foreground="#9B2C2C"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Подвал -->
        <Border Grid.Row="2" Background="#EDF2F7" Padding="12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="🔄 Новая партия" Width="150" Height="42" Margin="6"
                        Background="#2B6CB0" Foreground="White"/>
                <Button Content="🗑️ Отходы и брак" Width="150" Height="42" Margin="6"
                        Background="#9B2C2C" Foreground="White"/>
                <Button Content="📸 Фотофиксация" Width="150" Height="42" Margin="6"
                        Background="#4A5568" Foreground="White"/>
                <Button Content="📋 Отчёт о качестве" Width="160" Height="42" Margin="6"
                        Background="#2F855A" Foreground="White"/>
                <Button Content="🔧 Вызов техника" Width="150" Height="42" Margin="6"
                        Background="#718096" Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>