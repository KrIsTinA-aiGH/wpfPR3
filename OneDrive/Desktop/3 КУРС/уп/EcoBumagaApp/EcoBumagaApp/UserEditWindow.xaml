<Window x:Class="EcoBumagaApp.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление пользователя"
        Height="713"
        Width="440"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA"
        ResizeMode="CanMinimize">

    <Window.Resources>
        <!-- Стиль обязательных меток -->
        <Style x:Key="RequiredLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>

        <!-- Стиль обычных меток -->
        <Style x:Key="LabelStyle" TargetType="TextBlock" BasedOn="{StaticResource RequiredLabelStyle}">
            <Setter Property="Foreground" Value="#4A5568"/>
        </Style>

        <!-- Стиль полей ввода -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- Стиль кнопок -->
        <Style TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок в карточке -->
        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16"
                Margin="0,0,0,16">
            <TextBlock Text="Добавление нового пользователя"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#1F2A38"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Форма -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="Фамилия:" Style="{StaticResource LabelStyle}"/>
            <TextBox x:Name="txtLastName" Margin="0,0,0,12"/>

            <TextBlock Text="Имя:*" Style="{StaticResource RequiredLabelStyle}"/>
            <TextBox x:Name="txtFirstName" Margin="0,0,0,12"/>

            <TextBlock Text="Отчество:" Style="{StaticResource LabelStyle}"/>
            <TextBox x:Name="txtPatronymic" Margin="0,0,0,12"/>

            <TextBlock Text="Логин:*" Style="{StaticResource RequiredLabelStyle}"/>
            <TextBox x:Name="txtLogin" Margin="0,0,0,12"/>

            <TextBlock Text="Пароль:*" Style="{StaticResource RequiredLabelStyle}"/>
            <PasswordBox x:Name="txtPassword" Margin="0,0,0,12"/>

            <TextBlock Text="Повторите пароль:*" Style="{StaticResource RequiredLabelStyle}"/>
            <PasswordBox x:Name="txtPasswordConfirm" Margin="0,0,0,12"/>

            <TextBlock Text="Роль:*" Style="{StaticResource RequiredLabelStyle}"/>
            <ComboBox x:Name="cbRole"
                      DisplayMemberPath="RoleName"
                      Margin="0,0,0,16"/>

            <TextBlock x:Name="txtError"
                       Foreground="#9B2C2C"
                       FontWeight="Medium"
                       Margin="0,8,0,16"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="btnSave"
                    Content="Сохранить"
                    Background="#2B6CB0"
                    Foreground="White"
                    Click="BtnSave_Click"/>
            <Button x:Name="btnCancel"
                    Content="Отмена"
                    Background="#718096"
                    Foreground="White"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>